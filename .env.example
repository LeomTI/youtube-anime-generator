APP_ENV=development
DATABASE_URL=sqlite:////app/data/factory.db
DATA_DIR=/app/data
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
RUNWAY_API_KEY=
RUNWAY_API_BASE=https://api.dev.runwayml.com
RUNWAY_API_VERSION=2024-11-06
RUNWAY_MODEL=gen4_turbo
ENABLE_RUNWAY=false
YOUTUBE_CLIENT_SECRET=/app/secrets/client_secret.json
YOUTUBE_TOKEN_FILE=/app/secrets/token.json
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_MADE_FOR_KIDS=true
MONTHLY_BUDGET_USD=80
COST_PER_GROQ_JOB_USD=0.02
COST_PER_RUNWAY_SECOND_USD=0.05
DEFAULT_LANGUAGE=en
TTS_VOICE_MAP={"en":"en-US-AriaNeural","es":"es-ES-ElviraNeural","fr":"fr-FR-DeniseNeural","de":"de-DE-KatjaNeural","pt":"pt-BR-FranciscaNeural","hi":"hi-IN-SwaraNeural"}
MAX_SCENES=12
EPISODE_MINUTES=4
\n# auto probes NVIDIA NVENC; cpu forces CPU encoding\nVIDEO_ENCODER=auto\n